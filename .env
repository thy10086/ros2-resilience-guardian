# Safe defaults for local ROS 2 development
GUARDIAN_MAX_EVENT_AGE_SEC=5.0
GUARDIAN_REPLAY_WINDOW=128
GUARDIAN_DEFAULT_SPEED_LIMIT=0.35
GUARDIAN_SAFE_STOP_SPEED=0.0
# Optional HMAC signing
GUARDIAN_REQUIRE_SIGNATURE=false
# Set this only in a local secret store when signature verification is enabled.
# GUARDIAN_EVENT_SECRET=
