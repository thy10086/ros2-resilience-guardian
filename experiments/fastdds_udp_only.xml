<?xml version="1.0" encoding="UTF-8"?>
<!-- Diagnostic transport control, not the production default. Fast DDS 2.6
     Transport API: https://fast-rtps.docs.eprosima.com/en/2.6.x/fastdds/transport/transport_api.html -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>guardian_diagnostic_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="guardian_diagnostic" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>guardian_diagnostic_udp</transport_id></userTransports>
    </rtps>
  </participant>
</profiles>
